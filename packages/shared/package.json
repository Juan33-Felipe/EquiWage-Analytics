{
  "name": "@equiwage/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types, domain contracts, constants, validation schemas, and utilities for EquiWage Analytics.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./constants": {
      "types": "./src/constants/compensation.constants.d.ts",
      "default": "./src/constants/compensation.constants.js"
    },
    "./schemas": {
      "types": "./src/schemas/index.d.ts",
      "default": "./src/schemas/index.js"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "default": "./src/utils/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"console.log('@equiwage/shared: ESM + TypeScript definitions ready.')\"",
    "lint": "node --check ./src/index.js"
  }
}
