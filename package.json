{
  "name": "equiwage-analytics-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "EquiWage Analytics — Salary Structure Modeler and Validator",
  "author": "EquiWage Analytics",
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node ./packages/shared/src/utils/concurrent-runner.js",
    "dev:frontend": "npm run dev --workspace=@equiwage/frontend",
    "dev:backend": "npm run dev --workspace=@equiwage/backend",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@equiwage/shared",
    "build:frontend": "npm run build --workspace=@equiwage/frontend",
    "build:backend": "npm run build --workspace=@equiwage/backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:frontend": "npm run lint --workspace=@equiwage/frontend",
    "preview": "npm run preview --workspace=@equiwage/frontend",
    "electron:dev": "concurrently -k \"pnpm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:start": "electron .",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:all": "pnpm run build && electron-builder -mw"
  },
  "build": {
    "appId": "com.equiwage.analytics",
    "productName": "EquiWage Analytics",
    "copyright": "Copyright © 2026 EquiWage Analytics",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "apps/backend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "apps/backend/data/equiwage.sqlite",
        "to": "equiwage.sqlite"
      }
    ],
    "files": [
      "electron/**/*",
      "build/**/*",
      "apps/frontend/dist/**/*",
      "apps/backend/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EquiWage Analytics",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "wait-on": "^9.5.1"
  }
}
