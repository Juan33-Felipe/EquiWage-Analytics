{
  "name": "@equiwage/backend",
  "private": true,
  "version": "1.0.0",
  "description": "EquiWage Analytics Local Backend Server (Node.js + TypeScript + SQLite + AI Anonymization)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "tsx tests/phase1-runner.ts",
    "test:phase1": "tsx tests/phase1-runner.ts",
    "test:phase2": "tsx tests/phase2-runner.ts",
    "test:phase3": "tsx tests/phase3-runner.ts",
    "test:phase4": "tsx tests/phase4-runner.ts",
    "test:cross-device": "tsx tests/cross-device-runner.ts",
    "test:all": "tsx tests/phase1-runner.ts && tsx tests/phase2-runner.ts && tsx tests/phase3-runner.ts && tsx tests/phase4-runner.ts && tsx tests/cross-device-runner.ts",
    "build": "tsc -p tsconfig.json && npm run build:bundle",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --external:node:sqlite --external:sqlite --outfile=dist/server.bundle.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:seed": "tsx src/database/cli-seed.ts",
    "db:sync:neon": "tsx src/database/neon-sync.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@equiwage/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
