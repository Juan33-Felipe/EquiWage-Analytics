# EquiWage Analytics — Backend Environment Configuration
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# Local SQLite Persistence Path (relative to apps/backend or absolute path)
SQLITE_DB_PATH=./data/equiwage.sqlite

# ============================================================================
# AI Executive Diagnostics Configuration (RF-007)
# Supported AI_PROVIDER values: "gemini" | "openai" | "compatible"
# PRIVACY RULE: Only aggregated anonymized statistics are ever sent to the LLM.
# If AI_API_KEY is left empty, the backend automatically uses the local
# deterministic Executive Fallback Generator (100% offline capable).
# ============================================================================
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_API_BASE_URL=
AI_TIMEOUT_MS=12000

# ============================================================================
# Local Authentication & Session Security (RNF-001)
# ============================================================================
JWT_SECRET=equiwage-local-vault-secret-key-2026
JWT_EXPIRES_IN_HOURS=24
